<Window x:Class="Anastaria.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ANASTARIA Launcher" Icon="Assets/anastaria.ico" Width="1180" Height="720" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#080D18" Foreground="White">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Image Grid.ColumnSpan="2" Source="Assets/launcher-background.png" Stretch="UniformToFill" Opacity="0.52"/>
    <Border Grid.ColumnSpan="2" Background="#6608090D"/>
    <Border Background="#EA080D18" BorderBrush="#55D7A53C" BorderThickness="0,0,1,0">
      <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
            <Border Width="39" Height="39" BorderBrush="#BBD7A53C" BorderThickness="1" Background="#332B2110" RenderTransformOrigin=".5,.5" Margin="2,0,13,0">
              <Border.RenderTransform><RotateTransform Angle="45"/></Border.RenderTransform>
              <TextBlock Text="A" Foreground="#FFE5B84F" FontSize="21" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin=".5,.5">
                <TextBlock.RenderTransform><RotateTransform Angle="-45"/></TextBlock.RenderTransform>
              </TextBlock>
            </Border>
            <TextBlock Text="ANASTARIA" Foreground="{StaticResource Gold}" FontSize="23" FontWeight="Black" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="MU ONLINE" Foreground="#8291AA" FontSize="11" Margin="2,0,0,28"/>
          <Button x:Name="HomeButton" Click="Home_Click"/>
          <Button x:Name="NewsButton" Click="News_Click"/>
          <Button x:Name="EventsButton" Click="Events_Click"/>
          <Button x:Name="ShopButton" Click="Shop_Click"/>
          <Button x:Name="SettingsButton" Click="Settings_Click"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock x:Name="ServerLabel" Text="Server: verificare..." Foreground="#94A3B8" Margin="4,0,0,10"/>
          <ComboBox x:Name="LanguageBox" SelectionChanged="LanguageBox_SelectionChanged" Margin="0,0,0,10"/>
          <Button x:Name="WebsiteButton" Click="Website_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="34,26">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel>
        <StackPanel>
          <TextBlock x:Name="PageTitle" Text="BUN VENIT ÎN ANASTARIA" FontSize="25" FontWeight="SemiBold"/>
          <TextBlock x:Name="PageSubtitle" Text="Launcher oficial" Foreground="#8EA0BB" Margin="0,3,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBox x:Name="UsernameBox" Width="130"/>
          <PasswordBox x:Name="PasswordBox" Width="130"/>
          <Button x:Name="LoginButton" Click="Login_Click" Background="#735B2D"/>
        </StackPanel>
      </DockPanel>

      <Border Grid.Row="1" Background="#EE0E1118" BorderBrush="#55D7A53C" BorderThickness="1" CornerRadius="5" Margin="0,24,0,20" Padding="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="ContentPanel">
            <TextBlock x:Name="HeroTitle" Text="Lumea ANASTARIA te așteaptă." FontSize="34" FontWeight="Bold" Margin="0,70,0,12"/>
            <TextBlock x:Name="HeroDetail" Text="Verifică fișierele, conectează-te și pornește aventura dintr-un singur loc."
                       Foreground="#A8B5C9" FontSize="16" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left"/>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="OperationLabel" Text="Pregătit" Foreground="#9FB0C8"/>
          <ProgressBar x:Name="PatchProgress" Height="5" Margin="0,8,20,0" Minimum="0" Maximum="100"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="RepairButton" Click="Repair_Click"/>
          <Button x:Name="PlayButton" Click="Play_Click" Background="#A57A2C" FontWeight="Bold" Padding="25,12"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
