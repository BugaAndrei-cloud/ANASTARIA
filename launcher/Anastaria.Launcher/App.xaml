<Application x:Class="Anastaria.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Gold" Color="#D5A84B"/>
    <SolidColorBrush x:Key="Panel" Color="#DD111827"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#243247"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="10"/>
      <Setter Property="Margin" Value="0,4"/>
      <Setter Property="Background" Value="#172033"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#334155"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Padding" Value="10"/>
      <Setter Property="Margin" Value="0,4"/>
      <Setter Property="Background" Value="#172033"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#334155"/>
    </Style>
  </Application.Resources>
</Application>
